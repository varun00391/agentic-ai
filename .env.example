# Shared local-dev environment for frontend, API, worker, and Postgres.
# Docker Compose reads this file from v2/. Copy to .env if needed:
#   cp .env.example .env

# --- Ports ---
EXPENSE_V2_FRONTEND_PORT=3000
EXPENSE_V2_API_PORT=8000
EXPENSE_V2_POSTGRES_PORT=5432

# Empty means the browser calls same-origin /api (Vite proxy or nginx).
VITE_API_BASE_URL=

# --- Postgres ---
EXPENSE_V2_POSTGRES_USER=expense
EXPENSE_V2_POSTGRES_PASSWORD=expense
EXPENSE_V2_POSTGRES_DB=expense_v2
EXPENSE_V2_DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_v2

# --- API / worker ---
EXPENSE_V2_JWT_SECRET=replace-with-a-long-random-secret
EXPENSE_V2_JWT_EXPIRE_MINUTES=720
EXPENSE_V2_OBJECT_STORAGE_PATH=data/objects
EXPENSE_V2_PRIMARY_CURRENCY=INR
EXPENSE_V2_SUPPORTED_CURRENCIES=["INR"]
EXPENSE_V2_MAX_FILE_SIZE_MB=15
EXPENSE_V2_MAX_BATCH_FILES=10
EXPENSE_V2_MAX_TOTAL_MINOR_UNITS=100000000
EXPENSE_V2_MAX_AGENT_STEPS=80
EXPENSE_V2_MAX_TOOL_RETRIES=2
EXPENSE_V2_PLANNER=auto
EXPENSE_V2_MODEL=qwen/qwen3.8-27b
EXPENSE_V2_GROQ_API_KEY=
EXPENSE_V2_GROQ_BASE_URL=https://api.groq.com/openai/v1
EXPENSE_V2_EXTRACTION_MIN_CONFIDENCE=0.7
# Optional vision model. Empty means the same as EXPENSE_V2_MODEL.
EXPENSE_V2_VISION_MODEL=
EXPENSE_V2_RETAIN_OCR_TEXT=false
EXPENSE_V2_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
EXPENSE_V2_BOOTSTRAP_EMAIL=owner@example.com
EXPENSE_V2_BOOTSTRAP_PASSWORD=change-me-now
EXPENSE_V2_BOOTSTRAP_ORGANIZATION=Local Org
